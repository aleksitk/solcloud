{
  "name": "solcloud-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SolCloud deterministic demo function (labyrinth shortest-path) compiled to WebAssembly",
  "scripts": {
    "build": "asc assembly/index.ts --target release",
    "build:debug": "asc assembly/index.ts --target debug",
    "hash": "node scripts/hash.mjs",
    "run": "node scripts/run.mjs",
    "gen-vectors": "node scripts/gen-vectors.mjs",
    "verify": "node scripts/verify.mjs",
    "abi": "node scripts/abi.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.27.31"
  }
}
